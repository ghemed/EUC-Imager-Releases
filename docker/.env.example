# Copy to .env and fill in. Never share or commit the real file.

# Flask session signing key: any long random string
#   docker run --rm ghcr.io/ghemed/euc-imager:1.1.0 python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Encrypts the stored vCenter / Horizon / AD passwords. Back it up: losing it means re-entering them.
#   docker run --rm ghcr.io/ghemed/euc-imager:1.1.0 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AD_ENCRYPTION_KEY=

# Password for the PostgreSQL container
POSTGRES_PASSWORD=

# Optional
# EUC_VERSION=1.1.0          # image version to run
# HTTPS_PORT=443             # published HTTPS port
# HTTP_PORT=80               # published port that only redirects to HTTPS
# DATABASE_URL=              # use your own PostgreSQL or SQL Server instead of the container
